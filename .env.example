# Sao chép thành .env rồi điền giá trị thật (không commit .env)
PORT=3000
NODE_ENV=development
DATABASE_URL=
SITE_URL=
API_PUBLIC_URL=
# Danh sách origin được gọi API, ngăn cách bằng dấu phẩy. Bỏ trống khi chạy local để cho phép localhost.
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=public-files
# Render gói miễn phí chặn cổng 25/465/587: dùng relay cổng 2525 (ví dụ Brevo: smtp-relay.brevo.com)
SMTP_HOST=
SMTP_PORT=2525
# SMTP_USER = tên đăng nhập SMTP của Brevo, SMTP_PASS = khóa SMTP (không phải mật khẩu tài khoản)
SMTP_USER=
SMTP_PASS=
# Người gửi phải là địa chỉ đã xác minh ở Brevo, ví dụ: Mộc Thuận <email-cua-hang@...>
SMTP_FROM=
SHOP_EMAIL=
